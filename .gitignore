# Run artifacts under the campaign directories: predictions, per-run metrics and
# logs. Hundreds of MB, and every one regenerates from the job scripts in the
# same tree. The scripts themselves (.sh/.sbatch/.py) and notes (.md) stay
# tracked. To keep one deliberately: git add -f <path>
scripts/pooled/econ/**/*.json
scripts/pooled/econ/**/*.csv
scripts/pooled/econ/**/*.log
scripts/pooled/controls/**/*.json
scripts/pooled/controls/**/*.csv
scripts/pooled/controls/**/*.log
scripts/pooled/baselines/**/*.json
scripts/pooled/baselines/**/*.csv
scripts/pooled/baselines/**/*.log
scripts/pooled/diagnostic/**/*.json
scripts/pooled/diagnostic/**/*.csv
scripts/pooled/diagnostic/**/*.log

# Manuscript: drafts, figures and notes live with the paper, not the codebase.
paper/

